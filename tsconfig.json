{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "transcript-proxy/dist",
    "rootDir": "transcript-proxy/src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": [
    "transcript-proxy/src"
  ],
  "exclude": [
    "transcript-proxy/node_modules",
    "transcript-proxy/dist"
  ]
}